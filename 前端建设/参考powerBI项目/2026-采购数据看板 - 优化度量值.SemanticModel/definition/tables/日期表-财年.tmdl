	partition 日期表-财年 = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    '基础日期表',
				    // ========== 基础字段（英文，兼容性好） ==========
				    "DateKey", FORMAT([Date], "YYYYMMDD"),
				    "Year", YEAR([Date]),
				    "Quarter", QUARTER([Date]),
				    "QuarterName", "Q" & QUARTER([Date]),
				    "MonthNumber", MONTH([Date]),
				    "MonthName", FORMAT([Date], "MMMM"),
				    "MonthNameShort", FORMAT([Date], "MMM"),
				    
				    // ========== 周相关字段 ==========
				    "WeekNumber", WEEKNUM([Date], 2),
				    "DayOfWeek", WEEKDAY([Date], 2),
				    "DayName", FORMAT([Date], "dddd"),
				    
				    // ========== 排序字段 ==========
				    "YearQuarterSort", YEAR([Date]) * 10 + QUARTER([Date]),
				    "YearMonthSort", YEAR([Date]) * 100 + MONTH([Date]),
				    "YearWeekSort", YEAR([Date]) * 100 + WEEKNUM([Date], 2),
				    
				    // ========== 显示字段（中文） ==========
				    "年", YEAR([Date]),
				    "季度", "第" & QUARTER([Date]) & "季度",
				    "月份", MONTH([Date]) & "月",
				    "年季度", YEAR([Date]) & "年Q" & QUARTER([Date]),
				    "年月", YEAR([Date]) & "年" & MONTH([Date]) & "月",
				    
				    // ========== 财年相关字段（财年：7月1日 - 次年6月30日） ==========
				    
				    // 财年开始年份
				    "FiscalYear", 
				        IF(MONTH([Date]) >= 7, YEAR([Date]), YEAR([Date]) - 1),
				    
				    // 财年结束年份
				    "FiscalYearEnd",
				        IF(MONTH([Date]) >= 7, YEAR([Date]) + 1, YEAR([Date])),
				    
				    // 财年名称：FY2425 格式
				    "FiscalYearName", 
				        "FY" & 
				        RIGHT(IF(MONTH([Date]) >= 7, YEAR([Date]), YEAR([Date]) - 1), 2) & 
				        RIGHT(IF(MONTH([Date]) >= 7, YEAR([Date]) + 1, YEAR([Date])), 2),
				    
				    // 财年季度（1-4）
				    "FiscalQuarter", 
				        SWITCH(TRUE(),
				            MONTH([Date]) >= 7 && MONTH([Date]) <= 9, 1,
				            MONTH([Date]) >= 10 && MONTH([Date]) <= 12, 2,
				            MONTH([Date]) >= 1 && MONTH([Date]) <= 3, 3,
				            MONTH([Date]) >= 4 && MONTH([Date]) <= 6, 4
				        ),
				    
				    // 财年季度名称：FY2425 Q1
				    "FiscalQuarterName", 
				        "FY" & 
				        RIGHT(IF(MONTH([Date]) >= 7, YEAR([Date]), YEAR([Date]) - 1), 2) & 
				        RIGHT(IF(MONTH([Date]) >= 7, YEAR([Date]) + 1, YEAR([Date])), 2) & 
				        " Q" & 
				        SWITCH(TRUE(),
				            MONTH([Date]) >= 7 && MONTH([Date]) <= 9, 1,
				            MONTH([Date]) >= 10 && MONTH([Date]) <= 12, 2,
				            MONTH([Date]) >= 1 && MONTH([Date]) <= 3, 3,
				            MONTH([Date]) >= 4 && MONTH([Date]) <= 6, 4
				        ),
				    
				    // 财年月份编号（7月=1, 8月=2, ..., 6月=12）
				    "FiscalMonthNumber",
				        MOD(MONTH([Date]) - 7 + 12, 12) + 1,
				    
				    // 财年月份名称（1月-12月，对应7月-6月）
				    "FiscalMonthName",
				        SWITCH(TRUE(),
				            MONTH([Date]) >= 7 && MONTH([Date]) <= 9, "Q1",
				            MONTH([Date]) >= 10 && MONTH([Date]) <= 12, "Q2",
				            MONTH([Date]) >= 1 && MONTH([Date]) <= 3, "Q3",
				            MONTH([Date]) >= 4 && MONTH([Date]) <= 6, "Q4"
				        ),
				    
				    // 财年排序键
				    "FiscalYearSort", 
				        IF(MONTH([Date]) >= 7, YEAR([Date]), YEAR([Date]) - 1) * 100 + 
				        SWITCH(TRUE(),
				            MONTH([Date]) >= 7 && MONTH([Date]) <= 9, 1,
				            MONTH([Date]) >= 10 && MONTH([Date]) <= 12, 2,
				            MONTH([Date]) >= 1 && MONTH([Date]) <= 3, 3,
				            MONTH([Date]) >= 4 && MONTH([Date]) <= 6, 4
				        ),
				    
				    // 财年月排序键
				    "FiscalYearMonthSort", 
				        IF(MONTH([Date]) >= 7, YEAR([Date]), YEAR([Date]) - 1) * 100 + 
				        MOD(MONTH([Date]) - 7 + 12, 12) + 1,
				    
				    // 财年周数
				    "FiscalWeekNumber",
				        INT((DATEDIFF(
				            DATE(IF(MONTH([Date]) >= 7, YEAR([Date]), YEAR([Date]) - 1), 7, 1),
				            [Date],
				            DAY
				        ) + WEEKDAY(DATE(IF(MONTH([Date]) >= 7, YEAR([Date]), YEAR([Date]) - 1), 7, 1), 2) - 1) / 7) + 1
				
				)
				```

	annotation PBI_Id = 72358ee8a9eb44a89e43402bf5fd92b7

