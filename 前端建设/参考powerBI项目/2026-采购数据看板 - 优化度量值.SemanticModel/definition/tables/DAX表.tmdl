	measure WF_MonthChange =
			
			VAR Curr = [1_Total Amount]
			VAR Prev = CALCULATE([1_Total Amount], DATEADD('日期表-自然年'[Date], -1, MONTH))
			RETURN
			Curr - Prev
		formatString: "¥"#,0.###############;"¥"-#,0.###############;"¥"#,0.###############
		displayFolder: 其他
		lineageTag: a9957f4d-0027-4f8b-b08d-9b4cfd5c5b16

		annotation PBI_FormatHint = {"currencyCulture":"zh-CN"}

	measure '3_Total Amount__汇率_百万_RMB_PY_FY' =
			
			VAR CurrentFiscalYear = SELECTEDVALUE('日期表-财年'[FiscalYear])
			RETURN
			CALCULATE(
			    [2_Total Amount_汇率_百万_RMB],
			    REMOVEFILTERS('日期表-财年'[FiscalYearName]),
			    '日期表-财年'[FiscalYear] = CurrentFiscalYear - 1
			)
		displayFolder: 3、第二页KPI
		lineageTag: 9eb5c050-1e69-4410-8690-d2599e0162b6

		formatStringDefinition =
				VAR SelectedCurrency = SELECTEDVALUE('Currency Param'[Currency], "RMB")
				RETURN
				SWITCH(
				    SelectedCurrency,
				    "RMB", "¥ #,0 M",    -- 返回纯粹的格式字符串
				    "RM", "RM #,0 M",
				    "¥ #,0"
				)

	measure 参考线_∆P =
			
			VAR Base = MAX([Max_P] * 0.3, [最大范围] * 0.3)
			RETURN Base + [Gap]
		displayFolder: 5、复刻Zebra BI
		lineageTag: c44558b0-4a33-420d-89ef-82f3d350d815

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure x轴坐标max = [参考线_∆P%] + [Gap]*0.5
