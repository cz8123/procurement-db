table DAX表
	lineageTag: ee95b7b7-819b-45be-8fae-0859f2cb9b24

	/// 计算所有采购单(PRPO)的总采购金额，默认以人民币(¥)显示。
	/// 
	/// 测试注释：全部采购金额（原币，未做汇率换算）。由 WorkBuddy 添加于 2026-08-15。
	measure '1_Total Amount' =
			CALCULATE(
			    SUM(PO[Total Price])
			    )
		formatString: 0
		displayFolder: 1、Core Indicators | 基础指标
		lineageTag: 5a33a186-cd70-48c1-98e8-3ccfb1778d34

	/// 仅计算有框架合同编号的采购单的框架采购金额
	measure '1_Centralized Procurement' =
			
			CALCULATE(
			    SUM(PO[Total Price]),
			    'PO'[Procurement Method] IN { "SS-Exempt", "SS-Non Exempt", "Tender" }
			)
		formatString: 0
		displayFolder: 1、Core Indicators | 基础指标
		lineageTag: 96112a08-1fa8-4543-b154-a1f10d95f760

	/// 计算采购订单总数
	measure 1_Orders = CALCULATE(COUNT('PO'[No.]))
		formatString: #,0
		displayFolder: 1、Core Indicators | 基础指标
		lineageTag: 6f643311-d485-4e0d-b40c-c6529945cb82

	/// 计算参与采购的供应商数量
	measure 1_Suppliers = DISTINCTCOUNT(PO[Supplier_cn])
		formatString: #,0
		displayFolder: 1、Core Indicators | 基础指标
		lineageTag: f01de94f-04d2-48c2-8e27-3d500fd54c26

	/// 动态生成仪表板首页标题，显示当前年度
	measure 首页随时间变化标题 = "Total & Centralized Procurement Amount of "&max('日期表-财年'[FiscalYearName])
		displayFolder: 2、Formatting | 格式化显示
		lineageTag: f9aecd04-0465-46ef-9990-ee738a429083

	/// 数据集中的最大日期(不受日期筛选影响)，用于时间参数基准
	measure 2_MaxDate =
			
			CALCULATE(
			    MAX(PO[Date]),
			    REMOVEFILTERS('日期表-自然年'[Date]))
		formatString: General Date
		displayFolder: 9.3、Time Parameters | 时间参数
		lineageTag: c5a193b5-053f-452a-a7d5-4a5899f9c600

	/// 数据集中的最小日期(不受日期筛选影响)，用于时间参数基准
	measure 2_MinDate =
			
			CALCULATE(
			    MIN(PO[Date]),
			    REMOVEFILTERS('日期表-自然年'[Date]))
		formatString: General Date
		displayFolder: 9.3、Time Parameters | 时间参数
		lineageTag: fdc5688d-8792-494d-8ec6-7b5ed4c74ce2

	/// 返回当前选中的时间段(1W/1M/3M/TY/1Y/ALL)，来自日期选择参数表
	measure '3_Selected Dates' = SELECTEDVALUE('Date Selection'[Date Selection])
		displayFolder: 9.3、Time Parameters | 时间参数
		lineageTag: 229ef6f3-39d0-4864-a468-e406bd309256

	/// 根据选定时间段计算对应的时间范围开始日期
	measure '3_Selected Min Date' =
			
			Var MaxDate = [2_MaxDate] +1
			VAR MinDate = [2_MinDate] -1
			RETURN
			
			SWITCH([3_Selected Dates],
			    "1W",MaxDate -7,
			    "1M",EDATE(MaxDate, -1),
			    "3M",EDATE(MaxDate, -3),
			    "TY",DATE(YEAR(MaxDate), 1, 1),
			    "1Y",EDATE(MaxDate, -12),
			    "ALL",MinDate )
		formatString: General Date
		displayFolder: 9.3、Time Parameters | 时间参数
		lineageTag: f479a230-1346-4299-b24f-3aa7aa85f04b

	/// 根据选中指标(总金额/框架合同/订单数)动态返回对应的度量值，实现动态指标切换
	measure '3_Selected Core Indicators' =
			
			SWITCH(
			    SELECTEDVALUE('Core Indicators'[Indicator Name]),
			    "Total Amount", [2_Total Amount_汇率],
			    "Frame Contract", [2_CP_汇率],
			    "Orders", [1_Orders])
		formatString: "¥"#,0.###############;"¥"-#,0.###############;"¥"#,0.###############
		displayFolder: 9.3、Time Parameters | 时间参数
		lineageTag: a55525f1-5312-470a-9166-75e5824d9d9b

