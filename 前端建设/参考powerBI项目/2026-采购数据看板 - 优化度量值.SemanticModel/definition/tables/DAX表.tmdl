	measure P_视觉长度 =
			
			VAR RawVal = [P]
			VAR SafeVal = MAX(RawVal, 0.01)       // 0 自动转 0.01
			VAR MaxVal = MAX([Max_P], 0.01)
			VAR PowSmooth = POWER(SafeVal, 0.6)
			VAR MaxPow = POWER(MaxVal, 0.6)
			VAR Ratio = DIVIDE(PowSmooth, MaxPow, 0)
			RETURN
			IF(RawVal = 0, 0, Ratio * [Gap] * 0.6)  // P=0 显示 0 长度
		displayFolder: 5、复刻Zebra BI
		lineageTag: ab247314-5663-4c23-b76e-cd7e64a03bd5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

