	measure 3_YoY%_CP_FY = ```
			
			VAR CurrentFiscalYear = SELECTEDVALUE('日期表-财年'[FiscalYear])
			VAR PYValue = 
			    CALCULATE(
			        [2_CP_汇率],
			        REMOVEFILTERS('日期表-财年'[FiscalYearName]),
			        '日期表-财年'[FiscalYear] = CurrentFiscalYear - 1
			    )
			RETURN
			DIVIDE(
			    [2_CP_汇率] - PYValue,
			    PYValue,
			    0
			)
