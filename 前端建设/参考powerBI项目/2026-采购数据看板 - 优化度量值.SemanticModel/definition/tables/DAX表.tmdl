		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 返回一段 HTML 字符串，供 htmlContent 自定义视觉渲染 "Sales 同比卡片"。
	/// 颜色语义：同比上涨 -> 蓝 #1976D2；同比下跌 -> 红 #D32F2F。单位沿用"百万"口径（P / PY）。
	measure 'Card Sales YoY HTML' =
			
			VAR MaxPoDate =
			    CALCULATE(MAX(PO[Date]), REMOVEFILTERS('日期表-财年'))
			VAR LatestFY =
			    YEAR(MaxPoDate) - IF(MONTH(MaxPoDate) < 7, 1, 0)
			VAR SelFY =
			    IF(
			        HASONEVALUE('日期表-财年'[FiscalYear]),
			        SELECTEDVALUE('日期表-财年'[FiscalYear]),
			        LatestFY
			    )
			VAR Cur =
			    CALCULATE(
			        [2_Total Amount_汇率_百万],
			        REMOVEFILTERS('日期表-财年'),
			        '日期表-财年'[FiscalYear] = SelFY
			    )
			VAR Prev =
			    CALCULATE(
			        [2_Total Amount_汇率_百万],
			        REMOVEFILTERS('日期表-财年'),
			        '日期表-财年'[FiscalYear] = SelFY - 1
			    )
			VAR HasPrev = NOT ISBLANK(Prev) && Prev <> 0
			VAR Diff = IF(HasPrev, Cur - Prev, BLANK())
			VAR Pct = DIVIDE(Diff, Prev, BLANK())
			VAR IsUp = NOT ISBLANK(Pct) && Pct >= 0
			VAR Color = IF(ISBLANK(Pct), "#9AA0A6", IF(IsUp, "#1976D2", "#D32F2F"))
			VAR Sign = IF(Diff >= 0, "+", "-")
			VAR CurFmt = "¥" & FORMAT(Cur, "#,##0.0") & "M"
			VAR PrevFmt = "¥" & FORMAT(Prev, "#,##0.0") & "M"
			VAR DiffFmt = IF(ISBLANK(Diff), "—", "¥" & FORMAT(ABS(Diff), "#,##0.0") & "M")
			VAR PctFmt = IF(ISBLANK(Pct), "—", FORMAT(ABS(Pct), "0.0%"))
			VAR Icon = "<svg width='26' height='26' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><rect x='3' y='12' width='4.5' height='9' rx='1.5' fill='#1976D2' opacity='0.4'/><rect x='9.75' y='7.5' width='4.5' height='13.5' rx='1.5' fill='#1976D2' opacity='0.7'/><rect x='16.5' y='3' width='4.5' height='18' rx='1.5' fill='#1976D2'/></svg>"
			VAR FYTag = "FY" & RIGHT(SelFY, 2) & RIGHT(SelFY + 1, 2)
			RETURN
			"<div style='font-family:Segoe UI,Microsoft YaHei,Arial,sans-serif;padding:12px 16px;'>" &
			    "<div style='display:flex;align-items:center;gap:10px;'>" &
			        "<div style='width:40px;height:40px;border-radius:10px;background:#E3F2FD;display:flex;align-items:center;justify-content:center;'>" & Icon & "</div>" &
			        "<div style='font-size:17px;font-weight:600;color:#222;'>Sales &nbsp;<span style='font-size:12px;color:#9AA0A6;font-weight:400;'>(" & FYTag & ")</span></div>" &
			    "</div>" &
			    "<div style='display:flex;align-items:flex-end;justify-content:space-between;margin-top:10px;'>" &
			        "<div style='font-size:38px;font-weight:700;color:#111;letter-spacing:-1px;'>" & CurFmt & "</div>" &
			        "<div style='display:flex;gap:6px;'>" &
			            "<div style='background:" & Color & ";color:#fff;font-size:12px;font-weight:600;padding:6px 12px;border-radius:16px;white-space:nowrap;'>" & Sign & DiffFmt & "</div>" &
			            "<div style='background:" & Color & ";color:#fff;font-size:12px;font-weight:600;padding:6px 12px;border-radius:16px;white-space:nowrap;'>" & Sign & PctFmt & "</div>" &
			        "</div>" &
			    "</div>" &
			    "<div style='margin-top:6px;font-size:12px;color:#9AA0A6;'>vs previous FY " & PrevFmt & "</div>" &
			"</div>"
		displayFolder: 9、测试 | Card Test
		lineageTag: a7f8b0c1-2d3e-4f50-9a6b-7c8d9e0f1a2b

	partition DAX表 = m
		mode: import
		source =
				let
				    源 = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"列 1" = _t]),
				    更改的类型 = Table.TransformColumnTypes(源,{{"列 1", type text}}),
				    删除的列 = Table.RemoveColumns(更改的类型,{"列 1"})
				in
				    删除的列

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = 导航

