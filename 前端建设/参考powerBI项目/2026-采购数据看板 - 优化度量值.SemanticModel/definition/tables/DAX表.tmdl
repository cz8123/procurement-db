	measure 累计采购额_表格（受筛选影响） =
			
			VAR CurrentDate = MAX('日期表-自然年'[Date])
			VAR MinSelectedDate = MINX(ALLSELECTED('日期表-自然年'), '日期表-自然年'[Date])
			RETURN
			    CALCULATE(
			        [1_Total Amount],
			        FILTER(
			            ALL('日期表-自然年'),
			            '日期表-自然年'[Date] >= MinSelectedDate &&
			            '日期表-自然年'[Date] <= CurrentDate
			        )
			    )
		formatString: "¥"#,0;"¥"-#,0;"¥"#,0
