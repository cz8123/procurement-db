	measure '2_Total Amount_汇率_百万' = ```
			
			VAR SelectedRate = 
			    SELECTEDVALUE(
			        'Currency Param'[Rate], 
			        1   -- 默认值：如果没有选择任何货币，默认用人民币（汇率为1）
			    )
			VAR AmountInOriginalCurrency = [1_Total Amount] / SelectedRate
			RETURN
			DIVIDE(AmountInOriginalCurrency, 1000000)  -- 转换为百万单位
			```
		displayFolder: 2、Formatting | 格式化显示
		lineageTag: e067cb00-5078-4b6f-b24b-2a37b7db2225

		formatStringDefinition = " #,0 M"

	measure '3_YoY%_Total Amount_汇率_str_FY' = ```
			
			VAR CurrentFiscalYear = SELECTEDVALUE('日期表-财年'[FiscalYear])
			VAR PYValue = 
			    CALCULATE(
			        [2_Total Amount_汇率],
			        REMOVEFILTERS('日期表-财年'[FiscalYearName]),
			        '日期表-财年'[FiscalYear] = CurrentFiscalYear - 1
			    )
			VAR _1_YoY_Total_Amount =
			    [2_Total Amount_汇率] - PYValue
			VAR _Base_Amount =
			    PYValue
			VAR _Growth_Rate =
			    DIVIDE(_1_YoY_Total_Amount, _Base_Amount, 0)
			VAR _Sign =
			    SWITCH(
			        TRUE(),
			        _Growth_Rate > 0, "+",
			        _Growth_Rate < 0, "-",
			        ""
			    )
			VAR _Percentage_Text =
			    FORMAT(ABS(_Growth_Rate), "0%")
			RETURN
			    "(" & _Sign & _Percentage_Text & ")"
			```
		displayFolder: 4、首页KPI
		lineageTag: ebcce85c-05bb-4120-88a5-c6ef5de2bd10

