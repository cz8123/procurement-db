	measure 累计采购额_全局 =
			
			VAR CurrentDate = MAX('日期表-自然年'[Date])  -- 折线图当前点的日期
			RETURN
			CALCULATE(
			    [1_Total Amount],
			    REMOVEFILTERS('日期表-自然年'),  -- 移除日期表上的所有筛选器
			    FILTER(
			        ALL('日期表-自然年'),
			        '日期表-自然年'[Date] <= CurrentDate
			    )
			)
		formatString: "¥"#,0.###############;"¥"-#,0.###############;"¥"#,0.###############
