		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 误差线_∆P+ =
			
			VAR Raw = IF([P]>[PY], ABS([∆P]))
			VAR Ratio = DIVIDE(Raw, [Max_∆P], 0)
			VAR Limit = [Gap] * 0.5
			RETURN IF([P]>[PY], Ratio * Limit, BLANK())
		displayFolder: 5、复刻Zebra BI
		lineageTag: 10bb6bd0-c5c1-4650-af94-b02aa04599ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 误差线_∆P- =
			
			VAR Raw = IF([P]<=[PY], ABS([∆P]))
			VAR Ratio = DIVIDE(Raw, [Max_∆P], 0)
			VAR Limit = [Gap] * 0.5
			RETURN IF([P]<=[PY], -Ratio * Limit, BLANK())
		displayFolder: 5、复刻Zebra BI
		lineageTag: 993c66f2-b36b-48fb-bbd7-79505936a652

