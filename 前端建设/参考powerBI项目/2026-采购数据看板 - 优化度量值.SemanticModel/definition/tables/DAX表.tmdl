	/// 根据货币参数(Currency Param)调整汇率后的总采购金额，支持多币种显示(RMB/RM)
	measure '2_Total Amount_汇率' = ```
			
			VAR SelectedRate = 
			    SELECTEDVALUE(
			        'Currency Param'[Rate], 
			        1   -- 默认值：如果没有选择任何货币，默认用人民币（汇率为1）
			    )
			RETURN
			[1_Total Amount] / SelectedRate
			```
		displayFolder: 2、Formatting | 格式化显示
		lineageTag: 9b8cfc2f-b9da-4328-94ea-4f31dd4a61d3

		formatStringDefinition =
				VAR SelectedCurrency = SELECTEDVALUE('Currency Param'[Currency], "RMB")
				RETURN
				SWITCH(
				    SelectedCurrency,
				    "RMB", "¥ #,0",    -- 返回纯粹的格式字符串
				    "RM", "RM #,0",
				    "¥ #,0"
				)

	/// 根据货币参数(Currency Param)调整汇率后的框架采购金额，支持多币种显示(RMB/RM)
	measure 2_CP_汇率 = ```
			
			VAR SelectedRate = 
			    SELECTEDVALUE(
			        'Currency Param'[Rate], 
			        1   -- 默认值：如果没有选择任何货币，默认用人民币（汇率为1）
			    )
			RETURN
			[1_Centralized Procurement] / SelectedRate
			```
		displayFolder: 2、Formatting | 格式化显示
		lineageTag: 421246e9-fe8d-4992-a2b8-e5a0bae71d01

		formatStringDefinition =
				VAR SelectedCurrency = SELECTEDVALUE('Currency Param'[Currency], "RMB")
				RETURN
				SWITCH(
				    SelectedCurrency,
				    "RMB", "¥ #,0",    -- 返回纯粹的格式字符串
				    "RM", "RM #,0",
				    "¥ #,0"
				)

	/// 从参数表(Moving Average Table)获取选中的移动平均天数参数
	measure '5_Moving Average Selection' =
			
			//get the selected moving average value from the disconnected table
			
			SELECTEDVALUE('Moving Average'[Days])
		formatString: 0
		displayFolder: 9.4、Advanced Measures | 高级指标
		lineageTag: 48a28f2d-5254-4d5c-8369-ae2c300fcfbe

	/// 计算选定指标在选中天数内的移动平均值，用于趋势平滑分析
	measure '5_SM Moving Average' = ```
			
			    
			    AVERAGEX(                                   
			    DATESINPERIOD(                          //the dates from:                     
			        '日期表-自然年'[Date],                       //Current Date
			        LASTDATE(                           //Current Date - #Selected Months
			            '日期表-自然年'[Date] ), 
			            -[5_Moving Average Selection], 
			            DAY                           
			            ),                              
			         [3_Selected Core Indicators]               //For the selected measure
			         )
			         
			```
		formatString: "¥"#,0.###############;"¥"-#,0.###############;"¥"#,0.###############
		displayFolder: 9.4、Advanced Measures | 高级指标
		lineageTag: d185b491-b557-4b9a-a0b1-d46bf612fbda

		annotation PBI_FormatHint = {"currencyCulture":"zh-CN"}

	/// 以百万为单位显示多币种调整后的总采购金额，用于大数字仪表板展示
	measure '2_Total Amount_汇率_百万_RMB' = ```
			
			VAR SelectedRate = 
			    SELECTEDVALUE(
			        'Currency Param'[Rate], 
			        1   -- 默认值：如果没有选择任何货币，默认用人民币（汇率为1）
			    )
			VAR AmountInOriginalCurrency = [1_Total Amount] / SelectedRate
			RETURN
			DIVIDE(AmountInOriginalCurrency, 1000000)  -- 转换为百万单位
			```
		displayFolder: 2、Formatting | 格式化显示
		lineageTag: a49603a3-d86d-41ff-8a0b-57a2ab8b3f21

		formatStringDefinition = ```
				VAR SelectedCurrency = SELECTEDVALUE('Currency Param'[Currency], "RMB")
				VAR CurrencySymbol = 
				    SWITCH(
				        SelectedCurrency,
				        "RMB", "¥",
				        "RM", "RM"
				    )
				RETURN
				CurrencySymbol & " #,0 M"  -- 统一添加 M 后缀
				```

	/// 以百万为单位显示多币种调整后的框架采购金额，用于大数字仪表板展示
	measure 2_CP_汇率_百万_RMB = ```
			
			VAR SelectedRate = 
			    SELECTEDVALUE(
			        'Currency Param'[Rate], 
			        1   -- 默认值：如果没有选择任何货币，默认用人民币（汇率为1）
			    )
			VAR AmountInOriginalCurrency = [1_Centralized Procurement] / SelectedRate
			RETURN
			DIVIDE(AmountInOriginalCurrency, 1000000)  -- 转换为百万单位
			```
		displayFolder: 2、Formatting | 格式化显示
		lineageTag: 7211189e-5485-4d5b-9a67-b341a45d32d5

		formatStringDefinition = ```
				VAR SelectedCurrency = SELECTEDVALUE('Currency Param'[Currency], "RMB")
				VAR CurrencySymbol = 
				    SWITCH(
				        SelectedCurrency,
				        "RMB", "¥",
				        "RM", "RM"
				    )
				RETURN
				CurrencySymbol & " #,0 M"  -- 统一添加 M 后缀
				```

	/// 多币种调整后的合同价值，用于计算框架合同使用率(FWA Usage)
	measure '2_Contract Value_汇率' = ```
			
			VAR SelectedRate = 
			    SELECTEDVALUE(
			        'Currency Param'[Rate], 
			        1   -- 默认值：如果没有选择任何货币，默认用人民币（汇率为1）
			    )
			RETURN
			SELECTEDVALUE('PO'[Contract Value]) / SelectedRate
			```
		displayFolder: 2、Formatting | 格式化显示
		lineageTag: f4cc0d02-4d8c-4228-ba13-89edf0f5b347

		formatStringDefinition =
				VAR SelectedCurrency = SELECTEDVALUE('Currency Param'[Currency], "RMB")
				RETURN
				SWITCH(
				    SelectedCurrency,
				    "RMB", "¥ #,0",    -- 返回纯粹的格式字符串
				    "RM", "RM #,0",
				    "¥ #,0"
				)

	/// 按供应商计算帕累托累计百分比(从高到低排序)，用于80/20分析和供应商集中度评估
	measure '5_Cumulative Amount_by supplier' = ```
			
			VAR CurrentAmount = [2_Total Amount_汇率]  -- 当前供应商的采购额
			VAR TotalAll = CALCULATE([2_Total Amount_汇率], ALL( PO[Supplier_cn] )  -- 忽略所有供应商筛选
			)  -- 所有供应商总额
			VAR SuppliersGreaterOrEqual = 
			    FILTER(
			        ALL( PO[Supplier_cn] ),
			        [2_Total Amount_汇率] >= CurrentAmount  -- 找出采购额 >= 当前供应商的所有供应商
			    )
			VAR CumulativeAmount = 
			    SUMX( SuppliersGreaterOrEqual, [2_Total Amount_汇率] )  -- 计算这些供应商的总和
			RETURN
			DIVIDE( CumulativeAmount, TotalAll, 0 )
			```
		formatString: "¥"#,0.###############;"¥"-#,0.###############;"¥"#,0.###############
		displayFolder: 9.4、Advanced Measures | 高级指标
		lineageTag: e75fc668-4d55-4d13-86f9-b3f1181464e9

		annotation PBI_FormatHint = {"currencyCulture":"zh-CN"}

	measure 'Is Top 80%' = ```
			
			VAR CurrentCumulative = [5_Cumulative Amount_by supplier]
			VAR Threshold = 
			    MINX(
			        ALLSELECTED(PO[Supplier_cn]),
			        VAR Cum = [5_Cumulative Amount_by supplier]
			        RETURN IF(Cum >= 0.8, Cum)
			    )
			RETURN
			    IF(CurrentCumulative <= Threshold, 1, 0)
			```
		formatString: 0
		displayFolder: 9.4、Advanced Measures | 高级指标
		lineageTag: 985da9e9-e81a-4a82-bde5-9f765936fb6d

