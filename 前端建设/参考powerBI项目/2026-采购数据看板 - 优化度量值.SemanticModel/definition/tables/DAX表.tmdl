	measure 当前日期_带默认值 =
			
			VAR SelectedDate = [当前日期_用户选择]
			RETURN
			IF(
			    ISBLANK(SelectedDate),
			    MAX('日期表-自然年'[Date]),
			    SelectedDate
			)
		formatString: General Date
		displayFolder: 7、豁免采购加强分析
		lineageTag: ea0f5ab5-e1fa-4e7d-a6a4-176fb7f9cf21

	measure 滚动累计_动态 =
			
			VAR SelectedMonths = [动态窗口月数]
			VAR CurrentDate = [当前日期_带默认值]
			VAR StartDate = EDATE(CurrentDate, -SelectedMonths) + 1
			RETURN
			CALCULATE(
			    [1_Total Amount],
			    DATESBETWEEN('日期表-自然年'[Date], StartDate, CurrentDate),
			    ALLSELECTED('日期表-自然年')  // 忽略外部日期切片器，使用滚动窗口逻辑
			)
		formatString: "¥"#,0;"¥"-#,0;"¥"#,0
		displayFolder: 7、豁免采购加强分析
		lineageTag: f3eca38e-6a48-4324-9d71-9218dcbefd7c

		annotation PBI_FormatHint = {"currencyCulture":"zh-CN"}

	measure 是否违规_动态 =
			
			VAR RollingAmount = [滚动累计_动态]
			VAR Threshold = [动态违规阈值]
			RETURN
			RollingAmount >= Threshold
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: 7、豁免采购加强分析
		lineageTag: bfe3e56b-4e09-4f82-b100-f76e20966f2e

	measure 违规状态_动态 =
			
			SWITCH(
			    TRUE(),
			    [是否违规_动态], "⚠️ 违规",
			    "✓ 正常"
			)
		displayFolder: 7、豁免采购加强分析
		lineageTag: 7c480f94-0831-4606-8239-2d8de83fa72f

	measure 滚动累计_仅违规供应商_动态 =
			
			IF(
			    [是否违规_动态],
			    [滚动累计_动态],
			    BLANK()
			)
		formatString: "¥"#,0.###############;"¥"-#,0.###############;"¥"#,0.###############
		displayFolder: 7、豁免采购加强分析
