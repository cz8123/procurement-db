	partition 日期表-自然年 = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    '基础日期表',
				    // 基础字段（英文，兼容性好）
				    "DateKey", FORMAT([Date], "YYYYMMDD"),  // 日期键
				    "Year", YEAR([Date]),
				    "Quarter", QUARTER([Date]),  // 季度编号：1-4
				    "QuarterName", "Q" & QUARTER([Date]),  // 季度名称
				    "MonthNumber", MONTH([Date]),  // 月份编号
				    "MonthName", FORMAT([Date], "MMMM"),  // 月份全名
				    "MonthNameShort", FORMAT([Date], "MMM"),  // 月份缩写
				    
				    // 周相关字段
				    "WeekNumber", WEEKNUM([Date], 2),  // 周数（周一为第一天）
				    "DayOfWeek", WEEKDAY([Date], 2),  // 星期几编号（1=周一）
				    "DayName", FORMAT([Date], "dddd"),  // 星期几名称
				    
				    // 排序字段（关键！）
				    "YearQuarterSort", YEAR([Date]) * 10 + QUARTER([Date]),  // 可用于排序
				    "YearMonthSort", YEAR([Date]) * 100 + MONTH([Date]),
				    "YearWeekSort", YEAR([Date]) * 100 + WEEKNUM([Date], 2),
				    
				    // 显示字段（可自定义为中文）
				    "年", YEAR([Date]),
				    "季度", "第" & QUARTER([Date]) & "季度",
				    "月份", MONTH([Date]) & "月",
				    "年季度", YEAR([Date]) & "年Q" & QUARTER([Date]),
				    "年月", YEAR([Date]) & "年" & MONTH([Date]) & "月"
				)
				```

	annotation PBI_Id = 7f43c7b75c7b495f9229f541f2bd3670

